{
  "$ref": "#/definitions/Whales",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Whales": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "biography": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "birthYear": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "catalogId": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "deathYear": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "distinguishingMarks": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ecotype": {
                "enum": [
                  "RESIDENT",
                  "BIGGS",
                  "OFFSHORE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              "heroImageUrl": {
                "anyOf": [
                  {
                    "format": "uri",
                    "pattern": "^https?:\\/\\/",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notableEvents": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "birth",
                        "death",
                        "loss",
                        "capture",
                        "release",
                        "pod-switch",
                        "first-documented",
                        "milestone"
                      ],
                      "type": "string"
                    },
                    "year": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "year",
                    "type",
                    "summary"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "pod": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sex": {
                "enum": [
                  "MALE",
                  "FEMALE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              "sourceCitations": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "format": "uri",
                      "pattern": "^https?:\\/\\/",
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "url"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "status": {
                "enum": [
                  "ALIVE",
                  "DECEASED",
                  "UNKNOWN"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "catalogId",
              "name",
              "ecotype",
              "pod",
              "sex",
              "birthYear",
              "deathYear",
              "status",
              "biography",
              "distinguishingMarks",
              "heroImageUrl",
              "notableEvents",
              "sourceCitations"
            ],
            "type": "object"
          },
          "maxItems": 50,
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "hasMore": {
                  "const": true,
                  "type": "boolean"
                },
                "nextCursor": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "hasMore",
                "nextCursor"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "hasMore": {
                  "const": false,
                  "type": "boolean"
                },
                "nextCursor": {
                  "type": "null"
                }
              },
              "required": [
                "hasMore",
                "nextCursor"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "items",
        "page"
      ],
      "type": "object"
    }
  }
}
