{
  "$ref": "#/definitions/WhaleDetail",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "WhaleDetail": {
      "additionalProperties": false,
      "properties": {
        "biography": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "birthYear": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "deathYear": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "distinguishingMarks": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ecotype": {
          "enum": [
            "RESIDENT",
            "BIGGS",
            "OFFSHORE",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "heroImageUrl": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https?:\\/\\/",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "mother": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "catalogId": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "name": {
                  "anyOf": [
                    {
                      "maxLength": 20000,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "catalogId",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notableEvents": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "date": {
                "maxLength": 20000,
                "type": "string"
              },
              "source": {
                "maxLength": 20000,
                "type": "string"
              },
              "summary": {
                "maxLength": 20000,
                "type": "string"
              },
              "type": {
                "enum": [
                  "birth",
                  "death",
                  "loss",
                  "capture",
                  "release",
                  "pod-switch",
                  "first-documented",
                  "milestone"
                ],
                "type": "string"
              },
              "year": {
                "maximum": 9999,
                "minimum": 1000,
                "type": "integer"
              }
            },
            "required": [
              "year",
              "type",
              "summary"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "offspring": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "catalogId": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "name": {
                "anyOf": [
                  {
                    "maxLength": 20000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "catalogId",
              "name"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "pod": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recentSightings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "latitude": {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              },
              "locationName": {
                "anyOf": [
                  {
                    "maxLength": 20000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "longitude": {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              "observedAt": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "id",
              "observedAt",
              "locationName",
              "latitude",
              "longitude"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "sex": {
          "enum": [
            "MALE",
            "FEMALE",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "sourceCitations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "maxLength": 20000,
                "type": "string"
              },
              "url": {
                "format": "uri",
                "maxLength": 2048,
                "pattern": "^https?:\\/\\/",
                "type": "string"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "status": {
          "enum": [
            "ALIVE",
            "DECEASED",
            "UNKNOWN"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "catalogId",
        "name",
        "ecotype",
        "pod",
        "sex",
        "birthYear",
        "deathYear",
        "status",
        "biography",
        "distinguishingMarks",
        "heroImageUrl",
        "notableEvents",
        "sourceCitations",
        "mother",
        "offspring",
        "recentSightings"
      ],
      "type": "object"
    }
  }
}
