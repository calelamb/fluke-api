{
  "$ref": "#/definitions/Sightings",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Sightings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "behaviorNotes": {
            "type": [
              "string",
              "null"
            ]
          },
          "ecotypeGuess": {
            "anyOf": [
              {
                "enum": [
                  "RESIDENT",
                  "BIGGS",
                  "OFFSHORE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "groupSize": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "identifiedWhales": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "catalogId": {
                  "type": "string"
                },
                "confidence": {
                  "enum": [
                    "CONFIRMED",
                    "LIKELY",
                    "ML_SUGGESTED"
                  ],
                  "type": "string"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "catalogId",
                "name",
                "confidence"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "latitude": {
            "type": "number"
          },
          "locationName": {
            "type": [
              "string",
              "null"
            ]
          },
          "longitude": {
            "type": "number"
          },
          "observedAt": {
            "type": "string"
          },
          "photoUrls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "photos": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "orderIndex": {
                  "type": "integer"
                },
                "thumbnailUrl": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "url",
                "thumbnailUrl",
                "orderIndex"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "observedAt",
          "latitude",
          "longitude",
          "locationName",
          "ecotypeGuess",
          "groupSize",
          "behaviorNotes",
          "status",
          "photoUrls",
          "photos",
          "identifiedWhales"
        ],
        "type": "object"
      },
      "type": "array"
    }
  }
}
