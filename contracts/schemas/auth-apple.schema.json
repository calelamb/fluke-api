{
  "$ref": "#/definitions/AuthApple",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuthApple": {
      "additionalProperties": false,
      "properties": {
        "csrfToken": {
          "maxLength": 512,
          "minLength": 32,
          "type": "string"
        },
        "user": {
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "email": {
              "anyOf": [
                {
                  "format": "email",
                  "maxLength": 320,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "role": {
              "const": "OBSERVER",
              "type": "string"
            }
          },
          "required": [
            "displayName",
            "email",
            "id",
            "role"
          ],
          "type": "object"
        }
      },
      "required": [
        "csrfToken",
        "user"
      ],
      "type": "object"
    }
  }
}
