{
  "$ref": "#/definitions/Capabilities",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "type": "boolean"
        },
        "identification": {
          "type": "boolean"
        },
        "identificationMode": {
          "enum": [
            "disabled",
            "on-device",
            "server"
          ],
          "type": "string"
        },
        "submissions": {
          "type": "boolean"
        }
      },
      "required": [
        "accounts",
        "identification",
        "identificationMode",
        "submissions"
      ],
      "type": "object"
    }
  }
}
