{
  "name": "@fluke/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "22.17.0" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "audit": "pnpm audit --prod --audit-level=high",
    "build": "tsc",
    "contracts:check": "tsx scripts/check-contracts.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:runtime": "node dist/prisma/seed.js",
    "db:verify-seed": "tsx scripts/verify-seed.ts",
    "db:verify-seed:runtime": "node dist/scripts/verify-seed.js",
    "dev": "tsx watch src/index.ts",
    "dev:seed-history": "tsx scripts/seed-historical-sightings.ts",
    "jobs:acartia": "tsx scripts/run-job.ts acartia",
    "jobs:acartia:runtime": "node dist/scripts/run-job.js acartia",
    "jobs:gbif": "tsx scripts/run-job.ts gbif",
    "jobs:gbif:runtime": "node dist/scripts/run-job.js gbif",
    "jobs:predictions": "tsx scripts/run-job.ts predictions",
    "jobs:predictions:runtime": "node dist/scripts/run-job.js predictions",
    "layout:check": "bash scripts/check-standalone-layout.sh",
    "lint": "eslint src scripts prisma/seed.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/s3-request-presigner": "3.1090.0",
    "@fastify/compress": "9.1.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/static": "10.1.0",
    "@prisma/client": "5.22.0",
    "@smithy/node-http-handler": "4.9.7",
    "bcryptjs": "3.0.3",
    "dotenv": "16.4.7",
    "fastify": "5.10.0",
    "ipaddr.js": "2.4.0",
    "jose": "6.1.0",
    "prisma": "5.22.0",
    "sharp": "0.34.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.10.10",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.2",
    "form-data": "4.0.6",
    "pino-pretty": "13.0.0",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.53.0",
    "vite": "6.4.3",
    "vitest": "3.2.6",
    "zod-to-json-schema": "3.24.6"
  }
}
