# Copy this file to .env and fill in real values from your PostgreSQL provider.
# Get these from: https://console.neon.tech -> your project -> Connection Details
#
# DATABASE_URL = pooled connection string (hostname contains "-pooler")
#                Used at runtime by the app for queries
# DIRECT_URL   = direct connection string (no "-pooler" in hostname)
#                Used by Prisma migrations
DATABASE_URL="postgresql://[user]:[password]@[host]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[host].[region].aws.neon.tech/[dbname]?sslmode=require"

# "development" | "production" | "test"
# Production switches the admin cookie to secure: true and drops pretty-printed logs.
NODE_ENV="development"

PORT=4000

# Generate a secret with: openssl rand -base64 32
JWT_SECRET="replace_with_a_long_random_string_at_least_32_chars"
ADMIN_COOKIE_NAME="fluke_admin"

# Allowed browser origins for CORS (comma-separated, no trailing slash).
# Default permits both 5174 (current Vite port) and 5173 (legacy) in dev.
# In production, set to your web origin(s), e.g. "https://fluke.example,https://staging.fluke.example".
WEB_ORIGIN="http://localhost:5174,http://localhost:5173"

# Release A firewall. These are strict "true"/"false" values and default to
# false when omitted. Keep all three false in production for Release A.
ENABLE_SUBMISSIONS="false"
ENABLE_ACCOUNTS="false"
ENABLE_IDENTIFY="false"

# Photo storage backend. 'local' writes to uploads/ (gitignored) and
# the API serves files at /uploads/*. 'r2' is reserved for the R2 adapter
# stub in src/lib/storage.ts; flip when R2 credentials exist.
STORAGE_BACKEND="local"
UPLOADS_DIR="uploads"

# Absolute origin of the API; used to build photo URLs returned to the web.
# Production requires an explicit HTTPS, non-local, non-wildcard value here
# and for every WEB_ORIGIN entry.
API_PUBLIC_ORIGIN="http://localhost:4000"

# Local Python MiewID identifier service (fluke-model/scripts/serve_identifier.py).
IDENTIFIER_SERVICE_URL="http://localhost:4100"

# Required only when STORAGE_BACKEND="r2":
# R2_BUCKET=""
# R2_ENDPOINT=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_HOST=""
